# ---------------------------------------------------------------------------
# Jag Content Engine – variabili d'ambiente
# In produzione (GitHub Actions) questi valori arrivano dai GitHub Secrets.
# In locale copia questo file in `.env` e compila i valori per i test.
# ---------------------------------------------------------------------------

# JSON completo della chiave del Service Account Google (una sola riga).
GOOGLE_SERVICE_ACCOUNT={"type":"service_account", ...}

# ID del Google Sheet (la parte tra /d/ e /edit nell'URL del foglio).
GOOGLE_SHEET_ID=

# GID della scheda (tab) del foglio da leggere (numero dopo gid= nell'URL).
GOOGLE_SHEET_GID=0

# Chiave API OpenAI per la generazione dei contenuti.
OPENAI_API_KEY=

# Chiave API Zernio per la pubblicazione social.
ZERNIO_API_KEY=

# Facoltativo: ID dell'account Instagram collegato su Zernio.
# Se vuoto, il motore lo rileva automaticamente dal primo account Instagram.
ZERNIO_INSTAGRAM_ACCOUNT_ID=

# Facoltativo: ID dell'account Pinterest collegato su Zernio.
# Se vuoto, il motore lo rileva automaticamente dal primo account Pinterest.
ZERNIO_PINTEREST_ACCOUNT_ID=

# Facoltativo: se impostato a "true" il motore esegue tutto il flusso SENZA
# pubblicare realmente e SENZA aggiornare lo storico (utile per i test).
DRY_RUN=false

# Facoltativo: livello di log (debug | info | warn | error). Default: info.
LOG_LEVEL=info
